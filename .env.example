# Runtime connection (Neon pooled URL, or local URL during local-only development)
DATABASE_URL=
# Direct connection for Prisma schema changes and migrations
DIRECT_URL=
# Preserve the original local PostgreSQL connection when switching to Neon
DATABASE_URL_LOCAL=
# Set true when the PostgreSQL server requires SSL (including Neon)
DB_SSL=false
AUTH_SECRET=
NODE_ENV=development
